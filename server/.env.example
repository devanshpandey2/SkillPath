# SkillPath API configuration — copy to server/.env and edit.
# Everything is optional: unset DATABASE_URL → in-memory demo store,
# unset AI_* → deterministic (rule-based) engines. No keys are hard-coded.

# ---- Server ----
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set a strong random secret in production:
JWT_SECRET=dev-only-secret-change-me

# ---- Database (optional) ----
# When set, the server writes through to Postgres (apply server/src/data/schema.sql first).
# When unset, the app runs on an in-memory demo store with identical semantics.
# DATABASE_URL=postgres://user:password@localhost:5432/skillpath

# ---- AI / LLM (optional) ----
# Supported: openai | anthropic | gemini | groq
# Unset → deterministic fallbacks are used for resume analysis, JD parsing,
# roadmaps and project recommendations. Keys come ONLY from the environment.
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
